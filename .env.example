# =============================================================
# Variables de entorno raíz — leídas por docker-compose.yml
# Copia este archivo como .env y ajusta los valores
# NUNCA subas el .env real al repositorio
# =============================================================

# ------------------------------------------------------------------
# CREDENCIALES GOOGLE CLOUD
# Ruta ABSOLUTA en tu máquina host al archivo Service Account JSON
# Este archivo nunca debe estar dentro del repositorio
#
# Ejemplos:
#   Linux/Mac:  CREDENTIALS_PATH=/home/usuario/.secrets/sa.json
#   Windows:    CREDENTIALS_PATH=C:/Users/usuario/.secrets/sa.json
# ------------------------------------------------------------------
CREDENTIALS_PATH=/ruta/absoluta/a/tu/service_account.json

# ------------------------------------------------------------------
# CORS — orígenes permitidos para la API (separados por coma)
# Ajustar si accedes desde otra máquina en la red local
# Ejemplo red local: http://192.168.1.100:3003,http://192.168.1.100:8003
# ------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# ------------------------------------------------------------------
# NOTA: NEXT_PUBLIC_API_URL ya no es necesario.
# El proxy reverso en next.config.mjs redirige /api/* a pipeline-api:8000
# dentro de la red Docker. La interfaz funciona con cualquier IP sin rebuild.
# ------------------------------------------------------------------
