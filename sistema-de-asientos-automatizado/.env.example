# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service_account.json
GOOGLE_CLOUD_PROJECT_ID=your-project-id


# Cloud Vision + Gemini OCR (Fase 2)
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_OCR_LOCATION=europe-west1
VISION_MAX_RETRIES=3


# Gemini Árbitro (Fase 3)
GEMINI_ARBITRO_MODEL=gemini-2.5-flash
GEMINI_ARBITRO_LOCATION=europe-west1
GEMINI_ARBITRO_MAX_RETRIES=2


# Carpetas
SANDBOX_BASE_PATH=horeca_sandbox
FOLDER_COMPRAS_GASTOS=20_COMPRAS_GASTOS
FOLDER_VENTAS_INGRESOS=21_VENTAS_INGRESOS
FOLDER_BIENES_INVERSION=22_BIENES_INVERSION
FOLDER_PROCESADAS=90_PROCESADAS
FOLDER_INCIDENCIAS=99_INCIDENCIAS


# Output
OUTPUT_PATH=data/output
LOGS_PATH=logs


# OCR
EXTENSIONES_ADMITIDAS=pdf,jpg,jpeg,png,tiff,tif
# Umbral de confianza mínima para autocarga sin revisión humana
# 0.95 = solo facturas muy claras se auto-cargan; bajar con precaución
CONFIANZA_MINIMA=0.95
