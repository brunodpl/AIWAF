{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,route,loading,error,not-found,template,default}.{ts,tsx}",
    "e2e/**/*.spec.ts",
    "e2e-test.mjs",
    "e2e-test2.mjs",
    "playwright.*.config.ts",
    "**/*.test.{ts,tsx}"
  ],
  "project": ["**/*.{ts,tsx}", "e2e-test*.mjs"],
  "ignoreDependencies": ["postcss-load-config"],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  }
}
