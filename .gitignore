# Archivos de entorno — NUNCA subir al repo
.env
.env.local
.env.*.local

# Credenciales Docker / GHCR — contienen PAT en base64
.docker/

# Dependencias
node_modules/

# Build outputs
.next/
.next-smoke/
.next-ci/
out/
dist/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*~

# Git worktrees / [AI assistant] Code worktrees (cualquier nivel, incl. subproyectos)
.worktrees/
.[AI assistant]/worktrees/
**/.[AI assistant]/worktrees/

# Firecrawl scrape cache (resultados de scraping; no es código fuente)
.firecrawl/

# Trazabilidad 2.0 — datos runtime (inboxes de PDFs, asientos, logs, .runtime).
# Se crean automáticamente en cada despliegue; nunca deben commitearse.
libros/

# Maestro de clientes — se muta en runtime (contadores, fechas, altas).
# Semilla vacía + bind-mount del host; nunca debe commitearse con datos reales.
sistema-de-asientos-automatizado/data/maestros/maestro_clientes.yaml
sistema-de-asientos-automatizado/data/maestros/maestro_clientes.yaml.lock

# Playwright artifacts
test-results/
playwright-report/
interfaz-asientos-automatizados/test-results/
interfaz-asientos-automatizados/playwright-report/

# Pytest MagicMock leftover dirs (when tests escape sandboxing)
sistema-de-asientos-automatizado/MagicMock/
MagicMock/

# docker-compose build / deploy logs
compose-build.log

# Local [AI assistant] Code settings (user-specific)
.[AI assistant]/settings.local.json
