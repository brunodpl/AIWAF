libros/

# Maestro de clientes — se muta en runtime (contadores, fechas, altas).
# Semilla vacía + bind-mount del host; nunca debe commitearse con datos reales.
sistema-de-asientos-automatizado/data/maestros/maestro_clientes.yaml
sistema-de-asientos-automatizado/data/maestros/maestro_clientes.yaml.lock

